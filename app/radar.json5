// SFCW


// FMCW

{
  // Path where DCA1000 saves .bin data files (must exist)
  output_path: "C:\\Users\\Asus\\Desktop\\REPOZYTORIUM\\Distance-Measurment-Using-mmWave-Radars\\postproc\\data",

  channel_cfg: {
    // DFE output mode:
    // 1 = FRAME_BASED_CHIRPS
    // 3 = ADV_FRAME_CFG
    dfe_output_mode: 1,

    // RX channel mask:
    // 1  = 1 antenna   (0001b)
    // 3  = 2 antennas  (0011b)
    // 7  = 3 antennas  (0111b)
    // 15 = 4 antennas  (1111b)
    rx_channel_mask: 15,

    // TX channel mask:
    // 1 = TX1
    tx_channel_mask: 1,
  },

  adc_cfg: {
    // 2 = 16-bit
    num_adc_bits: 2,
    // 1 = complex 1x, 2 = complex 2x
    adc_output_fmt: 1,
  },
}
