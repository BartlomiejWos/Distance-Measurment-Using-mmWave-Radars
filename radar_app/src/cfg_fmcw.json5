{
  output_path: "C:\\Users\\Asus\\Desktop\\REPOZYTORIUM\\Distance-Measurment-Using-mmWave-Radars\\postproc\\data",
  com_port: "COM22",

  channel_cfg: {
    dfe_output_mode: 1,        // 1 = frame-based chirps, 3 = advanced frame cfg
    rx_channel_mask: 15,       // 1=RX1, 3=RX1-2, 7=RX1-3, 15=RX1-4 (4b bitmask)
    tx_channel_mask: 1,        // TX1 only (other TXs untested)
  },

  adc_cfg: {
    adc_output_fmt: 1,         // 1 = complex 1x, 2 = complex 2x
    low_power_adc_mode: 0,     // 0 = regular, 1 = low power
  },

  profile_cfg: {
    idle_time: 7,              // [usec] gap before chirp starts
    adc_start_time: 3,         // [usec] ADC sampling start offset after ramp begins
    ramp_end_time: 39,         // [usec] total chirp duration
    tx_out_power: 0,           // Tx output power back-off code (0 only tested)
    tx_phase_shifter: 0,       // Tx phase shift
    freq_slope_const: 29,      // [MHz/usec] chirp slope -> BW = slope * ramp_end_time
    num_adc_samples: 256,      // samples per chirp (must be even) -> range bins = N/2
    hpf_corner_freq1: 0,       // stage-1 HPF: 0=175kHz, 1=235kHz, 2=350kHz, 3=700kHz
    hpf_corner_freq2: 0,       // stage-2 HPF: 0=350kHz, 1=700kHz, 2=1.4MHz, 3=2.8MHz
    dig_out_sample_rate: 7200, // [ksps] ADC sample rate -> max range = c*Fs / (2*slope)
    tx_start_time: 1,          // [usec] TX enable offset from chirp start
    rx_gain: 30,               // [dB] RX gain
  },

  fmcw_cfg: {
    start_freq_Ghz: 77.5,        // [Hz] chirp start frequency (valid 76e9-81e9)
    frame: {
      num_loops: 128,          // chirps per frame; 1-255
      num_frames: 2,           // frames per capture; 1-65535 (0 = infinite — not supported in this app)
      frame_periodicity_ms: 50,// [ms] frame repetition period
    },
  },
}
